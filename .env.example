# Gabarit de configuration locale. À copier, PAS à remplir ici :
#
#   cp .env.example .env.local
#
# `.env.local` est ignoré par git ; ce fichier-ci est versionné et ne doit donc
# jamais contenir de vraie valeur.

# Chaîne de connexion Postgres. Provider recommandé : Neon (tier gratuit).
# Format : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
